; scip.ml/.mli are generated from scip.proto by ocaml-protoc (see the rule
; below); Scip_index/.Scip_resolver are hand-written on top of them.
(rule
 (targets scip.ml scip.mli)
 (deps
  scip.proto)
 (action
  (run ocaml-protoc --binary --ml_out . %{deps})))

(library
 (public_name semgrep.scip)
 (name semgrep_scip)
 (wrapped false)
 ; scip.ml is generated by ocaml-protoc, not hand-written; -w -11 silences
 ; the redundant-match-case warnings it emits for enum decoders.
 (flags (:standard -w -11))
 (libraries
  pbrt
  fpath
  commons
  lib_parsing
  semgrep_typing
  semgrep_core
  semgrep_engine))
